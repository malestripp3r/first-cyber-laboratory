<group name="local,kerberos,">

  <!-- Scénario 8 : TGT Kerberos réussi pour le compte de test -->
  <rule id="100120" level="3">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4768$</field>
    <field name="win.eventdata.targetUserName" type="pcre2">^soc\.kerb\.test$</field>
    <description>Homelab - Successful Kerberos TGT request for test account</description>
  </rule>

  <!-- Scénario 9 : échec individuel de préauthentification -->
  <rule id="100130" level="5">
    <if_sid>60104</if_sid>
    <field name="win.system.eventID">^4771$</field>
    <field name="win.eventdata.targetUserName" type="pcre2">^soc\.kerb\.test$</field>
    <field name="win.eventdata.status" type="pcre2">^0x18$</field>
    <description>Homelab - Kerberos authentication failure for test account</description>
  </rule>

  <!-- Trois échecs pour le même compte dans les 120 secondes -->
  <rule id="100131" level="10" frequency="3" timeframe="120">
    <if_matched_sid>100130</if_matched_sid>
    <same_field>win.eventdata.targetUserName</same_field>
    <description>Homelab - Multiple Kerberos failures within 120 seconds</description>
  </rule>

  <!-- Succès Kerberos après la corrélation des échecs -->
  <rule id="100132" level="11" frequency="2" timeframe="300">
    <if_sid>100120</if_sid>
    <if_matched_sid>100131</if_matched_sid>
    <same_field>win.eventdata.targetUserName</same_field>
    <description>Homelab - Kerberos success after repeated failures</description>
  </rule>

</group>
